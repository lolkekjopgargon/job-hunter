{
  "name": "job-hunter-app",
  "version": "1.0.0",
  "description": "Job Hunter Autonomous Desktop Application with Planka Kanban, HH Auth, and AI Engine",
  "main": "dist/main/main.js",
  "author": "Pavel Tejeda",
  "scripts": {
    "dev": "vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.main.json && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.pavel.jobhunter",
    "productName": "JobHunter",
    "icon": "assets/icon.png",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "src/engine/**/*",
      "assets/**/*",
      "index.html",
      "package.json"
    ],
    "asarUnpack": [
      "src/engine/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        { "target": "dir" }
      ]
    }
  }
}
